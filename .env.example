# Copy to .env (never commit it; it is excluded from the image). All values are optional.
PENGUWATCH_HOST=0.0.0.0
PENGUWATCH_PORT=8080
# Settings you can also change on the Settings tab: log level, time zone, the digest kind and hour, the digest
# address and the Grafana address. A variable you set here PINS that setting: the tab shows it read-only ("From
# environment") and a change needs an edit here and a restart. Leave a line empty or commented out to edit the
# setting on the tab instead. See docs/configuration.md.
# PENGUWATCH_LOG_LEVEL=info
# text (default) or json: one JSON object per line with request_id, for log tooling
PENGUWATCH_LOG_FORMAT=text
# IANA zone for "what day is it for the household" (renewal countdowns, aired today, notification hour),
# e.g. America/New_York. Empty = the TZ variable, else UTC. Stored timestamps stay UTC either way. Set here, it
# pins the Settings tab's time zone.
PENGUWATCH_TZ=

# --- Access control -------------------------------------------------------------------------
# Strongly recommended while the port is reachable beyond this machine. When set, every page and API call
# needs it (browsers sign in at /login once; scripts send "Authorization: Bearer <token>").
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PENGUWATCH_ACCESS_TOKEN=
# Host names (besides IP addresses, localhost, single-label names and *.local) the app may be reached by,
# comma separated; a leading dot matches subdomains, e.g. ".ts.net" for Tailscale.
PENGUWATCH_ALLOWED_HOSTS=
# Extra browser origins allowed to make changes (only for a reverse proxy with a different public name)
PENGUWATCH_ALLOWED_ORIGINS=
# Set to 1 when served over HTTPS so the session cookie is marked Secure
PENGUWATCH_COOKIE_SECURE=
# How many days a browser sign-in lasts (default 30; at least 1 hour = 0.0417, at most 400). The Services & Sync tab can also end them all.
PENGUWATCH_SESSION_MAX_AGE_DAYS=

# --- Notifications (ntfy topic URL, or any webhook that accepts JSON) -----------------------------
# All optional: the Settings tab sets the address (stored in secrets.json in the data folder), the kind and the
# hour. Setting a variable here pins it. The kind is ntfy or webhook; the hour is the local hour of the daily
# check (renewals, episodes airing today, failing sync), 0 to 23.
PENGUWATCH_NOTIFY_URL=
# PENGUWATCH_NOTIFY_KIND=ntfy
# PENGUWATCH_NOTIFY_HOUR=9

# SIMKL: usually set through the web UI (Connect SIMKL). Only needed to pre-seed.
SIMKL_CLIENT_ID=
SIMKL_ACCESS_TOKEN=

# --- Telemetry (OpenTelemetry over OTLP/HTTP; empty endpoint: nothing is exported) ---------------
# Traces, metrics and logs go to this collector, e.g. http://otel-collector:4318 (see
# docker-compose.override.example.yml for joining the collector's network).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=home
# Grafana's base URL: adds Dashboard / Logs / Traces links to the page header and the System tab
# (dashboard uid "penguwatch"), e.g. https://grafana.example:3000
PENGUWATCH_GRAFANA_URL=
